+    os.makedirs(synth_dir, exist_ok=True)
+    # `basename` alone collides across concurrent synthesize() calls for the
+    # same benchmark (e.g. LEVI evaluating several candidate grammars in
+    # parallel, each in its own subprocess). This was already half-
+    # anticipated (see the uid param this function has always accepted) but
+    # never actually applied to the filenames it was clearly meant for.
+    # Defaulting uid to the PID (below) gives each concurrent process a
+    # distinct one, so this can't just be reverted back to plain `basename`.
+    file_basename = f"{basename}_{uid}"
+    synth_file = synth_dir + file_basename + ".rkt"
+
+    # utils.rkt/bounded.rkt are NOT uid-suffixed -- the generated Racket file
+    # hardcodes `(require "./utils.rkt")` (rosette_translator.py), so the
+    # filename has to stay fixed. Their content never varies between calls,
+    # but a plain `open(..., "w")` truncates before writing, so a concurrent
+    # process racing to `require` this file mid-rewrite can see a corrupted
+    # or empty one -- reproduced directly: two threads each scoring a
+    # different grammar concurrently, and the well-formed one came back
+    # unverified because its Racket process choked on a torn read here.
+    # Write-to-temp-then-atomic-rename (os.replace, atomic on POSIX) means
+    # every reader sees either the complete old file or the complete new
+    # one, never a partial write, while keeping the filename `require`
+    # depends on unchanged.
+    for resource_name in ("utils.rkt", "bounded.rkt"):
+        target_path = synth_dir + resource_name
+        tmp_path = f"{target_path}.{os.getpid()}.tmp"
+        with open(tmp_path, "w") as out:
+            out.write(resources.read_text(utils, resource_name))
+        os.replace(tmp_path, target_path)
 
