+#!/usr/bin/env python3
+"""Regenerate the legacy `-analyze -loops` textual format metalift's
+`parse_loops()` (metalift/frontend/llvm.py) expects, using LLVM 15's new
+pass manager.
+
+`opt -analyze -loops` was removed after LLVM 11 (the version metalift's own
+compile-add-blocks.sh targets). The new-PM replacement, `print<loops>`,
+drops the per-function
+    Printing analysis 'Natural Loop Information' for function '<name>':
+header line metalift's parser keys on, and -filter-print-funcs (meant to
+scope the printer to one function) is not honored by this pass either --
+verified empirically, it prints every function's loops regardless.
+
+Instead we run with -debug-pass-manager, which logs "Running pass:
+LoopPrinterPass on <name>" immediately before that function's own loop
+lines on the same stream (verified: interleaving matches pass-manager
+scheduling order exactly). We reconstruct the legacy header from that.
+
+Usage: gen_loops_file.py <input.ll> <output.loops>
+"""
+
+import re
+import subprocess
+import sys
+
+RUNNING_RE = re.compile(r"^Running pass: LoopPrinterPass on (\S+)")
+
+
+def generate(ll_path: str) -> str:
+    proc = subprocess.run(
+        ["opt", "-debug-pass-manager", "-passes=function(print<loops>)", ll_path, "-o", "/dev/null"],
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    lines_out = []
+    for line in proc.stderr.splitlines():
+        match = RUNNING_RE.match(line)
+        if match:
+            fn_name = match.group(1)
+            lines_out.append(f"Printing analysis 'Natural Loop Information' for function '{fn_name}':")
+        elif line.startswith("Loop at depth"):
+            lines_out.append(line)
+    return "\n".join(lines_out) + "\n"
+
+
+def main() -> None:
+    if len(sys.argv) != 3:
+        print("usage: gen_loops_file.py <input.ll> <output.loops>", file=sys.stderr)
+        sys.exit(1)
+    output = generate(sys.argv[1])
+    with open(sys.argv[2], "w") as f:
+        f.write(output)
+
+
+if __name__ == "__main__":
+    main()
