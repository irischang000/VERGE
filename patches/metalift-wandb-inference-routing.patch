diff --git a/llmlift_scripts/constants.py b/llmlift_scripts/constants.py
index 23e4c722..4ab5f4d2 100644
--- a/llmlift_scripts/constants.py
+++ b/llmlift_scripts/constants.py
@@ -6,7 +6,25 @@ from dotenv import load_dotenv
 from openai import OpenAI
 
 load_dotenv()
-OPENAI_CLIENT = OpenAI(api_key=os.getenv("OPENAI_API_KEY"))
+
+# Route through W&B Inference (OpenAI-compatible) when there's no real
+# OPENAI_API_KEY but a WANDB_API_KEY is available (e.g. hackathon credits).
+# W&B Inference only hosts open-source models, so the model name has to
+# change too -- see GPT_MODEL below.
+_openai_api_key = os.getenv("OPENAI_API_KEY")
+_wandb_api_key = os.getenv("WANDB_API_KEY")
+if _openai_api_key:
+    OPENAI_CLIENT = OpenAI(api_key=_openai_api_key)
+    GPT_MODEL = os.getenv("METALIFT_GPT_MODEL", "gpt-4o")
+elif _wandb_api_key:
+    OPENAI_CLIENT = OpenAI(
+        api_key=_wandb_api_key, base_url="https://api.inference.wandb.ai/v1"
+    )
+    GPT_MODEL = os.getenv("METALIFT_GPT_MODEL", "Qwen/Qwen3-235B-A22B-Instruct-2507")
+else:
+    OPENAI_CLIENT = OpenAI(api_key=None)
+    GPT_MODEL = os.getenv("METALIFT_GPT_MODEL", "gpt-4o")
+
 CLAUDE_CLIENT = anthropic.Anthropic(api_key=os.getenv("CLAUDE_API_KEY"))
 
 INDENTATION = " " * 4
